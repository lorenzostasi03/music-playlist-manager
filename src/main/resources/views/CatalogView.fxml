<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="580.0" prefWidth="900.0" styleClass="content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.musicplaylistmanager.controller.CatalogController">

    <!-- HEADER -->
    <VBox spacing="10" styleClass="screen-header">

        <padding>
            <Insets bottom="12" left="20" right="20" top="16" />
        </padding>

        <!-- TOOLBAR -->
        <HBox alignment="CENTER_LEFT" spacing="8">

            <!-- Search -->
            <TextField fx:id="searchField" promptText="Cerca brano..." HBox.hgrow="ALWAYS" />

            <!-- Filters -->
            <ComboBox fx:id="genreFilter" promptText="Genere" styleClass="select" />

            <ComboBox fx:id="authorFilter" promptText="Autore" styleClass="select" />

            <ComboBox fx:id="yearFilter" promptText="Anno" styleClass="select" />

            <ComboBox fx:id="tagFilter" promptText="Tag" styleClass="select" />

            <!-- Add button -->
            <Button fx:id="addTrackButton" onAction="#onAddTrack" styleClass="btn-primary" text="+ Aggiungi" />

        </HBox>

    </VBox>

    <!-- COLUMN HEADERS -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="col-header">

        <padding>
            <Insets bottom="4" left="20" right="20" top="4" />
        </padding>

        <Label maxWidth="Infinity" styleClass="col-h" text="Titolo" HBox.hgrow="ALWAYS" />

        <Label alignment="CENTER_RIGHT" prefWidth="90" styleClass="col-h-right" text="Autore" />

        <Label alignment="CENTER_RIGHT" prefWidth="70" styleClass="col-h-right" text="Genere" />

        <Label alignment="CENTER_RIGHT" prefWidth="55" styleClass="col-h-right" text="Anno" />

        <Label alignment="CENTER_RIGHT" prefWidth="60" styleClass="col-h-right" text="Durata" />

        <Region prefWidth="120" />

    </HBox>

    <!-- TRACK LIST -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="list-area" VBox.vgrow="ALWAYS" />

</VBox>
