<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" style="-fx-background-color: #000000;" stylesheets="@style.css" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.musicplaylistmanager.controller.playlist.PlaylistController">
    <VBox spacing="15" style="-fx-border-color: #282828; -fx-border-width: 0 0 1 0;">
        <padding><Insets bottom="20" left="25" right="25" top="25" /></padding>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="playlistNameLabel" style="-fx-text-fill: #FFFFFF; -fx-font-size: 32px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', sans-serif;" text="Nome Playlist" />
            <Separator orientation="VERTICAL" style="-fx-opacity: 0;" />
            <Label fx:id="trackCountLabel" style="-fx-text-fill: #B3B3B3; -fx-font-size: 16px; -fx-font-weight: bold;" text="0 brani" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <padding><Insets top="5" /></padding>
            <Button fx:id="playButton" onAction="#onPlay" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-min-width: auto; -fx-min-height: auto; -fx-padding: 8 20 8 20;" styleClass="play-btn" text="▶  Riproduci" />
         <Button fx:id="enqueButton" onAction="#onEnqueue" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-min-width: auto; -fx-min-height: auto; -fx-padding: 8 20 8 20;" styleClass="play-btn" text="Aggiungi alla coda" />
            <Button fx:id="editNameButton" onAction="#onRename" style="-fx-background-color: #121212; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15 8 15; -fx-cursor: hand;" text="Rinomina" />
            <Button fx:id="deletePlaylistButton" onAction="#onDeletePlaylist" style="-fx-background-color: transparent; -fx-text-fill: #1DB954; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="Elimina playlist" />
        </HBox>
    </VBox>
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-border-color: #282828; -fx-border-width: 0 0 1 0;">
        <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
        <TextField fx:id="searchField" onKeyReleased="#onSearchChanged" prefHeight="36.0" prefWidth="198.0" promptText="Cerca per titolo…" style="-fx-background-color: #121212; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #B3B3B3; -fx-background-radius: 8; -fx-padding: 8 15 8 15; -fx-font-size: 14px;" />
        <Button fx:id="sortButton" disable="true" onAction="#onSort" style="-fx-background-color: #121212; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15 8 15; -fx-cursor: hand;" text="Ordina per" /> 
        <ComboBox fx:id="sortComboBox" disable="true" minWidth="130" styleClass="dark-combo" />
        <Button fx:id="addTrackButton" onAction="#onAddTrack" style="-fx-background-color: transparent; -fx-border-color: #1DB954; -fx-border-radius: 8; -fx-text-fill: #1DB954; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 7 15 7 15; -fx-cursor: hand;" text="+ Aggiungi traccia" />
    </HBox>
    <StackPane VBox.vgrow="ALWAYS">
        <TableView fx:id="tracksTable" style="-fx-background-color: #000000; -fx-control-inner-background: #000000; -fx-table-cell-border-color: #121212; -fx-padding: 5;" VBox.vgrow="ALWAYS">
            <placeholder><Label style="-fx-text-fill: #B3B3B3; -fx-font-size: 16px;" text="Nessuna traccia trovata" /></placeholder>
            <columns>
                <TableColumn fx:id="indexColumn" prefWidth="35" text="#" />
                <TableColumn fx:id="titleColumn" prefWidth="120" text="Titolo" />
                <TableColumn fx:id="authorColumn" prefWidth="100" text="Autore" />
                <TableColumn fx:id="durationColumn" prefWidth="60" text="Durata" />
                <TableColumn fx:id="genreColumn" prefWidth="80" text="Genere" />
                <TableColumn fx:id="yearColumn" prefWidth="45" text="Anno" />
                <TableColumn fx:id="tagsColumn" prefWidth="220" text="Tag" />
            </columns>
        </TableView>
    </StackPane>
    <HBox fx:id="removeTrackBar" alignment="CENTER_LEFT" spacing="8" style="-fx-border-color: #282828; -fx-border-width: 1 0 0 0;">
        <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
        <Button fx:id="removeTrackButton" disable="true" onAction="#onRemoveTrack" style="-fx-background-color: transparent; -fx-text-fill: #1DB954; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" styleClass="play-btn" text="Rimuovi selezionata" />
    </HBox>
</VBox>
