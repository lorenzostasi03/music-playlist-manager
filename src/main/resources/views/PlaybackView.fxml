<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<HBox prefHeight="580.0" prefWidth="680.0" stylesheets="@style.css" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.musicplaylistmanager.controller.PlaybackController">
    <fx:define>
        <ToggleGroup fx:id="playModeGroup" />
    </fx:define>
    <VBox alignment="CENTER" spacing="18" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="16" left="24" right="24" top="16" />
        </padding>
        <StackPane maxHeight="210" maxWidth="210" prefHeight="210" prefWidth="210" style="-fx-background-color: #121212; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 20, 0, 0, 10);">
            <Label style="-fx-text-fill: #282828; -fx-font-size: 80px;" text="♪" />
        </StackPane>
        <VBox alignment="CENTER" spacing="6">
            <Label fx:id="trackTitleLabel" maxWidth="390" style="-fx-text-fill: #FFFFFF; -fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', sans-serif;" text="Nessuna traccia" wrapText="true" />
            <Label fx:id="trackArtistLabel" maxWidth="390" style="-fx-text-fill: #1DB954; -fx-font-size: 15px; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold;" text="" wrapText="true" />
        </VBox>
        <VBox maxWidth="390" prefWidth="390" spacing="8">
            <Slider fx:id="progressSlider" value="37" style="-fx-cursor: hand;" />
            <HBox alignment="CENTER">
                <Label fx:id="currentTimeLabel" style="-fx-text-fill: #B3B3B3; -fx-font-size: 12px; -fx-font-weight: bold;" text="2:12" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="totalTimeLabel" style="-fx-text-fill: #B3B3B3; -fx-font-size: 12px; -fx-font-weight: bold;" text="5:55" />
            </HBox>
        </VBox>
        <HBox alignment="CENTER" spacing="18">
            <Button fx:id="previousButton" onAction="#onPrevious" minWidth="92" styleClass="transparent-btn" text="Precedente" />
            <Button fx:id="playPauseButton" onAction="#onPlayPause" styleClass="play-btn" text="Play" />
            <Button fx:id="nextButton" onAction="#onNext" minWidth="92" styleClass="transparent-btn" text="Successiva" />
        </HBox>
        <VBox alignment="CENTER" spacing="8">
            <HBox alignment="CENTER" spacing="8">
                <ToggleButton fx:id="sequentialModeButton" toggleGroup="$playModeGroup" onAction="#onSequential" selected="true" minWidth="125" styleClass="mode-btn" text="Sequenziale" />
                <ToggleButton fx:id="shuffleModeButton" toggleGroup="$playModeGroup" onAction="#onShuffle" minWidth="125" styleClass="mode-btn" text="Shuffle" />
            </HBox>
            <HBox alignment="CENTER" spacing="8">
                <ToggleButton fx:id="loopTrackButton" toggleGroup="$playModeGroup" onAction="#onLoopTrack" minWidth="125" styleClass="mode-btn" text="Loop traccia" />
                <ToggleButton fx:id="loopPlaylistButton" toggleGroup="$playModeGroup" onAction="#onLoopPlaylist" minWidth="125" styleClass="mode-btn" text="Loop playlist" />
            </HBox>
        </VBox>
        <Label fx:id="playCountLabel" style="-fx-text-fill: #B3B3B3; -fx-font-size: 12px; -fx-font-weight: bold;" text="142 RIPRODUZIONI TOTALI" />
    </VBox>
    <VBox maxWidth="210" minWidth="210" prefWidth="210" style="-fx-background-color: #0A0A0A; -fx-border-color: #121212; -fx-border-width: 0 0 0 1;">
        <VBox spacing="10">
            <padding>
                <Insets bottom="14" left="14" right="14" top="24" />
            </padding>

            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', sans-serif;" text="Coda di riproduzione" wrapText="true" />

            <Button fx:id="skipPlayableButton" onAction="#onSkipPlayable" maxWidth="Infinity" styleClass="spotify-btn" text="Riproduci prossimo" wrapText="true" />
        </VBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #0A0A0A; -fx-background-color: transparent; -fx-control-inner-background: #0A0A0A; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="queueView" style="-fx-padding: 0 5 0 5;" />
            </content>
        </ScrollPane>
    </VBox>
</HBox>
