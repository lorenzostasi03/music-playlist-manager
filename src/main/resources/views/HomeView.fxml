<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600" prefWidth="900"
      spacing="0"
      stylesheets="@style.css"
      style="-fx-background-color: #000000;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unisa.musicplaylistmanager.controller.HomeController">

    <!-- HEADER -->
    <VBox spacing="15">
        <padding>
            <Insets bottom="16" left="25" right="25" top="25" />
        </padding>

        <Label text="Home"
               style="-fx-text-fill: #FFFFFF; -fx-font-size: 28px; -fx-font-weight: bold;" />

        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="searchBar"
                       maxWidth="Infinity"
                       prefWidth="340"
                       promptText="Cerca playlist..."
                       style="-fx-background-color: #121212; -fx-text-fill: #FFFFFF;" />

            <Region HBox.hgrow="ALWAYS" />

            <MenuButton fx:id="autoCreateBtn"
                        disable="true"
                        minWidth="160"
                        text="Playlist automatica">
                <items>
                    <MenuItem text="Per genere" onAction="#onAutoCreateByGenre"/>
                    <MenuItem text="Per anno" onAction="#onAutoCreateByYear"/>
                    <MenuItem text="Per artista" onAction="#onAutoCreateByArtist"/>
                    <MenuItem text="Per tag" onAction="#onAutoCreateByTag"/>
                </items>
            </MenuButton>

            <Button fx:id="newPlaylistBtn"
                    text="+ Nuova playlist"
                    minWidth="140"
                    onAction="#onNewPlaylist"
                    styleClass="spotify-btn"/>
        </HBox>
    </VBox>

    <!-- SORT BAR -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <padding>
            <Insets bottom="10" left="25" right="25" top="0" />
        </padding>

        <Label text="Ordina per:" style="-fx-text-fill: #B3B3B3;" />

        <ComboBox fx:id="sortComboBox"
                  onAction="#onSortChanged"
                  minWidth="150"
                  styleClass="dark-combo"/>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="countLabel"
               text="0 playlist"
               style="-fx-text-fill: #B3B3B3; -fx-font-size: 12px;"/>
    </HBox>

    <!-- HEADER LISTA -->
    <HBox spacing="0" style="-fx-border-color: #282828; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets bottom="10" left="25" right="25" top="10" />
        </padding>

        <Label text="NOME" prefWidth="300"
               style="-fx-text-fill: #B3B3B3; -fx-font-weight: bold;" />

        <Label text="BRANI" prefWidth="60"
               style="-fx-text-fill: #B3B3B3; -fx-font-weight: bold;" />

        <Label text="DURATA" prefWidth="80"
               style="-fx-text-fill: #B3B3B3; -fx-font-weight: bold;" />

        <Label text="RIPRODUZIONI" prefWidth="90"
               style="-fx-text-fill: #B3B3B3; -fx-font-weight: bold;" />

        <Region prefWidth="144"/>
    </HBox>

    <!-- LISTA / EMPTY STATE -->
    <StackPane VBox.vgrow="ALWAYS">

        <VBox fx:id="emptyStateBox"
              alignment="CENTER"
              spacing="12"
              visible="false"
              managed="false">

            <Label text="Nessuna playlist"
                   style="-fx-text-fill: #FFFFFF; -fx-font-size: 22px; -fx-font-weight: bold;" />

            <Label text="Crea la tua prima playlist per organizzare la musica."
                   wrapText="true"
                   maxWidth="300"
                   style="-fx-text-fill: #B3B3B3;" />
        </VBox>

        <ListView fx:id="playlistListView"
                  onMouseClicked="#onListViewClicked"
                  style="-fx-background-color: #000000; -fx-border-color: transparent;" />
    </StackPane>

</VBox>
