<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox prefHeight="480" prefWidth="580" spacing="0" style="-fx-background-color: #1C1C1E;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.musicplaylistmanager.controller.song.SongPickerController">
    <VBox spacing="4" style="-fx-border-color: #2C2C2E; -fx-border-width: 0 0 1 0;">
        <padding><Insets bottom="16" left="24" right="24" top="20" /></padding>
        <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', sans-serif;" text="Aggiungi tracce" />
        <Label style="-fx-text-fill: #8E8E93; -fx-font-size: 14px;" text="Seleziona i brani da aggiungere alla playlist" />
    </VBox>
    <Separator style="-fx-opacity: 0; -fx-padding: 0;" />
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-border-color: #2C2C2E; -fx-border-width: 0 0 1 0;">
        <padding><Insets bottom="12" left="24" right="24" top="12" /></padding>
        <TextField fx:id="searchField" onKeyReleased="#onSearchChanged" prefWidth="260" promptText="Cerca per titolo…" style="-fx-background-color: #000000; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #8E8E93; -fx-background-radius: 8; -fx-padding: 8 15 8 15; -fx-font-size: 14px;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="selectAllButton" onAction="#onSelectAll" style="-fx-background-color: transparent; -fx-text-fill: #EBEBF5; -fx-font-size: 13px; -fx-cursor: hand;" text="Seleziona tutti" />
        <Button fx:id="deselectAllButton" onAction="#onDeselectAll" style="-fx-background-color: transparent; -fx-text-fill: #EBEBF5; -fx-font-size: 13px; -fx-cursor: hand;" text="Deseleziona tutti" />
    </HBox>
    <Separator style="-fx-opacity: 0; -fx-padding: 0;" />
    <StackPane VBox.vgrow="ALWAYS">
        <TableView fx:id="tracksTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #1C1C1E; -fx-control-inner-background: #1C1C1E; -fx-table-cell-border-color: #2C2C2E; -fx-padding: 5;">
            <placeholder>
                <Label style="-fx-text-fill: #8E8E93; -fx-font-size: 14px;" text="Nessuna traccia disponibile" />
            </placeholder>
            <columns>
                <TableColumn fx:id="checkColumn" prefWidth="40" text="" />
                <TableColumn fx:id="titleColumn" prefWidth="210" text="Titolo" />
                <TableColumn fx:id="authorColumn" prefWidth="150" text="Autore" />
                <TableColumn fx:id="genreColumn" prefWidth="90" text="Genere" />
                <TableColumn fx:id="yearColumn" prefWidth="60" text="Anno" />
            </columns>
        </TableView>
        <VBox fx:id="emptyStateBox" alignment="CENTER" managed="false" spacing="8" visible="false">
            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 16px; -fx-font-weight: bold;" text="Tutte le tracce del catalogo sono già in questa playlist" />
        </VBox>
    </StackPane>
    <Separator style="-fx-opacity: 0; -fx-padding: 0;" />
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-border-color: #2C2C2E; -fx-border-width: 1 0 0 0;">
        <padding><Insets bottom="16" left="24" right="24" top="16" /></padding>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="cancelButton" onAction="#onCancel" style="-fx-background-color: transparent; -fx-text-fill: #EBEBF5; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="Annulla" />
        <Button fx:id="confirmButton" defaultButton="true" disable="true" onAction="#onConfirm" style="-fx-background-color: #1DB954; -fx-text-fill: #000000; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20 8 20; -fx-cursor: hand;" text="Aggiungi" />
    </HBox>
</VBox>
