<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480" prefWidth="580" spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.musicplaylistmanager.controller.song.SongPickerController">

    <!-- ══════════════════════ HEADER ══════════════════════ -->
    <VBox spacing="4">
        <padding><Insets bottom="16" left="24" right="24" top="20" /></padding>
        <Label text="Aggiungi tracce" />
        <Label text="Seleziona i brani da aggiungere alla playlist" />
    </VBox>

    <Separator />

    <!-- ══════════════════════ TOOLBAR ══════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <padding><Insets bottom="12" left="24" right="24" top="12" /></padding>
        <TextField fx:id="searchField" onKeyReleased="#onSearchChanged" prefWidth="260" promptText="Cerca per titolo…" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="selectAllButton" onAction="#onSelectAll" text="Seleziona tutti" />
        <Button fx:id="deselectAllButton" onAction="#onDeselectAll" text="Deseleziona tutti" />
    </HBox>

    <Separator />

    <!-- ══════════════════════ BODY ══════════════════════ -->
    <StackPane VBox.vgrow="ALWAYS">

        <TableView fx:id="tracksTable" VBox.vgrow="ALWAYS">

            <placeholder>
                <Label text="Nessuna traccia disponibile" />
            </placeholder>

            <columns>
                <TableColumn fx:id="checkColumn" prefWidth="40" text="" />
                <TableColumn fx:id="titleColumn" prefWidth="210" text="Titolo" />
                <TableColumn fx:id="authorColumn" prefWidth="150" text="Autore" />
                <TableColumn fx:id="genreColumn" prefWidth="90" text="Genere" />
                <TableColumn fx:id="yearColumn" prefWidth="60" text="Anno" />
            </columns>
        </TableView>

        <!-- Stato vuoto -->
        <VBox fx:id="emptyStateBox" alignment="CENTER" managed="false" spacing="8" visible="false">
            <Label text="Tutte le tracce del catalogo sono già in questa playlist" />
        </VBox>

    </StackPane>

    <Separator />

    <!-- ══════════════════════ FOOTER ══════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <padding><Insets bottom="14" left="24" right="24" top="14" /></padding>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="cancelButton" onAction="#onCancel" text="Annulla" />
        <Button fx:id="confirmButton" defaultButton="true" disable="true" onAction="#onConfirm" text="Aggiungi" />
    </HBox>

</VBox>
