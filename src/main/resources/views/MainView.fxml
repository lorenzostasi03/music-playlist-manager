<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.musicplaylistmanager.controller.MainController">

    <top>
        <HBox prefHeight="50.0" prefWidth="900.0" BorderPane.alignment="CENTER">

            <children>

                <Button fx:id="homeButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onHome" prefHeight="100.0" prefWidth="300.0" text="Home" textAlignment="CENTER">

                    <graphic>
                        <ImageView fitHeight="35.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>

                </Button>

                <Button fx:id="catalogButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onCatalog" prefHeight="100.0" prefWidth="300.0" text="Catalogo" textAlignment="CENTER">

                    <graphic>
                        <ImageView fitHeight="35.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>

                </Button>

                <Button fx:id="playbackButton" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onPlayback" prefHeight="100.0" prefWidth="300.0" text="Riproduzione" textAlignment="CENTER">

                    <graphic>
                        <ImageView fitHeight="35.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>

                </Button>

            </children>

        </HBox>
    </top>

</BorderPane>
